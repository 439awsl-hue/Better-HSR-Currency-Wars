        <Setter Property="BorderBrush" Value="{StaticResource InGameBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource InGameHoverBrush}" />
