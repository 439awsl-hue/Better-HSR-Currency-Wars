  <Grid Margin="0" Background="#F5F9FE">
    <Grid.RowDefinitions>
      <RowDefinition Height="112" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#EAFDFEFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="70" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="12,0,8,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Source="Assets/app.ico" Width="22" Height="22" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Better HSR-Currency Wars V11" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource TitleBarButton}" Click="MinimizeWindow_Click">—</Button>
            <Button Style="{StaticResource TitleBarButton}" Click="ToggleMaximizeWindow_Click">□</Button>
            <Button Style="{StaticResource CloseTitleBarButton}" Click="CloseWindow_Click">×</Button>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Padding="20,0,18,12" Background="#00FFFFFF">
          <DockPanel LastChildFill="True">
            <TextBlock Name="StatusText" DockPanel.Dock="Right" Text="状态：未运行" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Better HSR-Currency Wars V11" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" />
              <TextBlock Text="B站UID19365312   抖音号：71243602656   QQ群794857027   当前工具还在测试中，出现 bug 记得找我哦" Foreground="{StaticResource MutedBrush}" FontSize="12" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Row="1" Margin="12,10,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="170" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Grid.Column="2" CornerRadius="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,10" Margin="0" Effect="{StaticResource CardShadow}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="24" />
            <RowDefinition Height="60" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Click="TestDebuffOcr_Click">测试词条 OCR</Button>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="TestFullWindowOcr_Click">测试全窗口 OCR</Button>
            <Button Name="StartAutoButton" Grid.Column="4" Style="{StaticResource PrimaryButton}" Click="StartAutomation_Click">局外识别自动刷新</Button>
            <Button Name="StartCustomInGameButton" Grid.Column="6" Style="{StaticResource InGameButton}" Click="StartCustomInGame_Click">局内识别自定义刷新</Button>
            <Button Name="StopAutoButton" Grid.Column="8" Style="{StaticResource DangerButton}" IsEnabled="False" Click="StopAutomation_Click">停止 F8</Button>
          </Grid>
          <Grid Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
