          <Trigger Property="IsPressed" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryPressedBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="InGameButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource InGameBrush}" />
