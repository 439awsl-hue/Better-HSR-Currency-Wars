                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
